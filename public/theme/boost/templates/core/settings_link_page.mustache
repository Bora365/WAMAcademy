{{!
    @template core/settings_link_page

    Site administration home (WAM override of the Moodle core template).

    The admin tree is still produced by Moodle; only the markup differs: each category
    pane lists its groups as a heading followed directly by its links. The category tabs
    live in the left administration drawer when "secondarynavigation" is present
    (see local_wamakademi/admin_nav); otherwise the original horizontal tabs are rendered.

    Example context (json):
    {
        "node": {
            "text": "Root of menu",
            "key": "test0",
            "display": true,
            "children": [
                {
                    "text": "Child of menu",
                    "key": "test1",
                    "display": true,
                    "children": []
                }
            ]
        }
    }
}}
{{^secondarynavigation}}
    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item">
            <a class="nav-link active" href="#link{{node.key}}" data-bs-toggle="tab" role="tab" aria-selected="true">{{node.text}}</a>
        </li>
        {{#node.children}}
            {{#children.count}}
                {{#display}}
                    {{^is_short_branch}}
                        <li class="nav-item">
                            <a class="nav-link" href="#link{{key}}" data-bs-toggle="tab" role="tab" aria-selected="false" tabindex="-1">{{text}}</a>
                        </li>
                    {{/is_short_branch}}
                {{/display}}
            {{/children.count}}
        {{/node.children}}
    </ul>
{{/secondarynavigation}}
<div class="wam-adm-home">
    <p class="wam-adm-lead">{{#str}} adminhomedesc, local_wamakademi {{/str}}</p>
    <div class="tab-content wam-adm-panes">
        <div class="tab-pane active wam-adm-pane" id="link{{node.key}}" role="tabpanel"
             {{#secondarynavigation}}aria-labelledby="wam-adm-tab-link{{node.key}}"{{/secondarynavigation}}>
            <div class="wam-adm-groups">
                <section class="wam-adm-group wam-adm-group--leaf" aria-labelledby="wam-adm-h-{{node.key}}">
                    <h2 class="wam-adm-group__title" id="wam-adm-h-{{node.key}}">{{#str}} general {{/str}}</h2>
                    <ul class="wam-adm-links list-unstyled">
                        {{#node.children}}
                            {{^children.count}}
                                {{#display}}
                                    <li class="wam-adm-links__item"><a href="{{{action}}}">{{text}}</a></li>
                                {{/display}}
                            {{/children.count}}
                        {{/node.children}}
                    </ul>
                </section>
                {{#node.children}}
                    {{#display}}
                        {{#children.count}}
                            {{#is_short_branch}}
                                <section class="wam-adm-group" aria-labelledby="wam-adm-h-{{key}}">
                                    <h2 class="wam-adm-group__title" id="wam-adm-h-{{key}}">
                                        {{#action}}<a class="wam-adm-group__link" href="{{{action}}}">{{text}}</a>{{/action}}
                                        {{^action}}{{text}}{{/action}}
                                    </h2>
                                    <ul class="wam-adm-links list-unstyled">
                                        {{#children}}
                                            {{> core/settings_link_page_single }}
                                        {{/children}}
                                    </ul>
                                </section>
                            {{/is_short_branch}}
                        {{/children.count}}
                    {{/display}}
                {{/node.children}}
            </div>
        </div>
        {{#node.children}}
            {{#children.count}}
                <div class="tab-pane wam-adm-pane" id="link{{key}}" role="tabpanel"
                     {{#secondarynavigation}}aria-labelledby="wam-adm-tab-link{{key}}"{{/secondarynavigation}}>
                    <div class="wam-adm-groups">
                        <section class="wam-adm-group wam-adm-group--leaf" aria-labelledby="wam-adm-h-{{key}}">
                            <h2 class="wam-adm-group__title" id="wam-adm-h-{{key}}">
                                {{#action}}<a class="wam-adm-group__link" href="{{{action}}}">{{text}}</a>{{/action}}
                                {{^action}}{{text}}{{/action}}
                            </h2>
                            <ul class="wam-adm-links list-unstyled">
                                {{#children}}
                                    {{#display}}
                                        {{^children.count}}
                                            <li class="wam-adm-links__item"><a href="{{{action}}}">{{text}}</a></li>
                                        {{/children.count}}
                                    {{/display}}
                                {{/children}}
                            </ul>
                        </section>
                        {{#children}}
                            {{#display}}
                                {{#children.count}}
                                    <section class="wam-adm-group" aria-labelledby="wam-adm-h-{{key}}">
                                        <h2 class="wam-adm-group__title" id="wam-adm-h-{{key}}">
                                            {{#action}}<a class="wam-adm-group__link" href="{{{action}}}">{{text}}</a>{{/action}}
                                            {{^action}}{{text}}{{/action}}
                                        </h2>
                                        <ul class="wam-adm-links list-unstyled">
                                            {{#children}}
                                                {{> core/settings_link_page_single }}
                                            {{/children}}
                                        </ul>
                                    </section>
                                {{/children.count}}
                            {{/display}}
                        {{/children}}
                    </div>
                </div>
            {{/children.count}}
        {{/node.children}}
    </div>
</div>
