<div class="wam-dashboard">

    <section class="wam-home-hero" aria-label="WAM Akademi">
        <div class="wam-home-hero__content">
            <span class="wam-home-hero__badge">WAM Akademi</span>
            <h1>Geleceği Birlikte İnşa Ediyoruz</h1>
            <p>Saha ekiplerinden ofise, herkesin birlikte geliştiği eğitimler.</p>
        </div>
    </section>

    <header class="wam-page-header">
        <div class="wam-page-header__text">
            <p class="wam-page-header__eyebrow">WAM Akademi</p>
            <h2 class="wam-page-header__title">Merhaba, {{firstname}}</h2>
            <p class="wam-page-header__desc">
                Öğrenme yoluna kaldığın yerden devam et veya yeni eğitimlere göz at.
            </p>
        </div>
        <div class="wam-page-header__actions">
            <a href="{{herocontinueurl}}" class="wam-btn wam-btn--primary">
                Kaldığın yerden devam et
            </a>
            <a href="{{config.wwwroot}}/local/wamakademi/catalog.php" class="wam-btn wam-btn--secondary">
                Eğitimlere göz at
            </a>
        </div>
    </header>

    <section class="wam-stats" aria-label="Özet" role="group">
        <button
            type="button"
            class="wam-stat-card"
            data-wam-dash-filter="ongoing"
            aria-pressed="false"
        >
            <div class="wam-stat-icon" aria-hidden="true">▶</div>
            <div>
                <span>Devam eden</span>
                <strong>{{ongoingcount}}</strong>
            </div>
        </button>
        <button
            type="button"
            class="wam-stat-card"
            data-wam-dash-filter="completed"
            aria-pressed="false"
        >
            <div class="wam-stat-icon" aria-hidden="true">✓</div>
            <div>
                <span>Tamamlanan</span>
                <strong>{{completedcount}}</strong>
            </div>
        </button>
    </section>

    <div class="wam-content-grid">
        <main class="wam-main-content">
            <section class="wam-section" data-wam-dash-courses>
                <div class="wam-section-header">
                    <h2>Eğitimlerim</h2>
                    <a href="{{config.wwwroot}}/local/wamakademi/mycourses.php">
                        Tümünü gör
                    </a>
                </div>

                <div class="wam-course-grid" data-wam-dash-grid>
                    {{#hascourses}}
                        {{#courses}}
                            <article class="wam-course-card" data-status="{{status}}">
                                <a href="{{courseurl}}" class="wam-course-cover wam-course-cover--link">
                                    {{#hascourseimage}}
                                        <img src="{{courseimage}}"
                                             alt=""
                                             class="wam-course-image">
                                    {{/hascourseimage}}
                                    {{^hascourseimage}}
                                        <div class="wam-course-fallback">
                                            {{shortname}}
                                        </div>
                                    {{/hascourseimage}}
                                </a>
                                <div class="wam-course-info">
                                    <span class="wam-course-category">{{category}}</span>
                                    <h3>
                                        <a href="{{courseurl}}" class="wam-course-title-link">{{fullname}}</a>
                                    </h3>
                                    <div class="wam-progress-header">
                                        <span>İlerleme</span>
                                        <strong>{{progress}}%</strong>
                                    </div>
                                    <div class="wam-progress">
                                        <div class="wam-progress-value"
                                             style="width: {{progress}}%;"></div>
                                    </div>
                                    {{#hasactionlink}}
                                        <a href="{{continueurl}}" class="wam-course-button">
                                            {{actionlabel}}
                                        </a>
                                    {{/hasactionlink}}
                                    {{^hasactionlink}}
                                        <span class="wam-course-button">{{actionlabel}}</span>
                                    {{/hasactionlink}}
                                </div>
                            </article>
                        {{/courses}}
                    {{/hascourses}}

                    {{^hascourses}}
                        <div class="wam-empty-state">
                            <p>Henüz atanmış bir eğitimin yok.</p>
                            <a class="wam-btn wam-btn--primary"
                               href="{{config.wwwroot}}/local/wamakademi/catalog.php">
                                Kataloga git
                            </a>
                        </div>
                    {{/hascourses}}
                </div>

                {{#hascourses}}
                    <div class="wam-empty-state" data-wam-dash-empty hidden>
                        <p>Bu durumda gösterilecek eğitim yok.</p>
                    </div>
                {{/hascourses}}
            </section>
        </main>

        <aside class="wam-sidebar">
            <div class="wam-section-header">
                <h2>Yaklaşanlar</h2>
                <a href="{{config.wwwroot}}/local/wamakademi/calendar.php">
                    Takvim
                </a>
            </div>
            <div class="wam-empty-state wam-empty-state--compact">
                <p>Yaklaşan bir etkinlik bulunmuyor.</p>
            </div>
        </aside>
    </div>
</div>
