{{!
    @template local_wamakademi/participants_actions

    Single "Actions" menu shown at the end of every row of the participants table.

    The menu is opened and navigated by js/participants_table.js. Enrolment items keep the
    data-action attributes and the data-* container that core_user/status_field (AMD) expects, so the
    existing enrolment dialogues (details, edit, remove with confirmation) keep working unchanged.

    Context variables required for this template:
    * triggerid string - Id of the menu button.
    * menuid string - Id of the menu.
    * label string - Visible button text.
    * triggerlabel string - Accessible name of the button (includes the participant name).
    * caneditroles bool - Show the "edit role" item.
    * caneditgroups bool - Show the "edit group" item.
    * editroleslabel string
    * editgroupslabel string
    * detailslabel string
    * enrolments array - One entry per enrolment method:
      * fullname, coursename, enrolinstancename, status, timestart, timeend, timeenrolled string
      * multiple bool - More than one enrolment: group is labelled with its method name.
      * actions array - url, label, class, attributes (name/value pairs)

    Example context (json):
    {
        "triggerid": "wam-rowmenu-t-4-btn",
        "menuid": "wam-rowmenu-t-4",
        "label": "Actions",
        "triggerlabel": "Actions: Jane Doe",
        "caneditroles": true,
        "caneditgroups": true,
        "editroleslabel": "Edit role",
        "editgroupslabel": "Edit group",
        "detailslabel": "Enrolment details",
        "enrolments": [
            {
                "fullname": "Jane Doe",
                "coursename": "Course",
                "enrolinstancename": "Manual enrolments",
                "status": "Active",
                "timestart": "",
                "timeend": "",
                "timeenrolled": "1 January 2026",
                "multiple": false,
                "actions": [
                    {
                        "url": "#",
                        "label": "Edit enrolment",
                        "class": "editenrollink",
                        "attributes": [{"name": "data-action", "value": "editenrolment"}]
                    }
                ]
            }
        ]
    }
}}
<div class="wam-row-actions" data-wam-row-actions>
    <button type="button" class="wam-row-actions__trigger" id="{{triggerid}}" aria-haspopup="menu"
            aria-expanded="false" aria-controls="{{menuid}}" aria-label="{{triggerlabel}}">{{label}}</button>
    <div class="wam-row-actions__menu" id="{{menuid}}" role="menu" aria-labelledby="{{triggerid}}" hidden>
        {{#caneditroles}}
        <button type="button" class="wam-row-actions__item" role="menuitem" tabindex="-1"
                data-wam-action="edit-roles">{{editroleslabel}}</button>
        {{/caneditroles}}
        {{#caneditgroups}}
        <button type="button" class="wam-row-actions__item" role="menuitem" tabindex="-1"
                data-wam-action="edit-groups">{{editgroupslabel}}</button>
        {{/caneditgroups}}
        {{#enrolments}}
        <div class="wam-row-actions__group" {{#multiple}}role="group" aria-label="{{enrolinstancename}}"{{/multiple}}{{^multiple}}role="none"{{/multiple}}
             data-fullname="{{fullname}}" data-coursename="{{coursename}}" data-enrolinstancename="{{enrolinstancename}}"
             data-status="{{status}}" data-timestart="{{timestart}}" data-timeend="{{timeend}}" data-timeenrolled="{{timeenrolled}}">
            <a href="#" class="wam-row-actions__item" role="menuitem" tabindex="-1" data-action="showdetails">{{detailslabel}}</a>
            {{#actions}}
            <a href="{{url}}" class="wam-row-actions__item {{class}}" role="menuitem" tabindex="-1" {{#attributes}}{{name}}="{{value}}" {{/attributes}}>{{label}}</a>
            {{/actions}}
        </div>
        {{/enrolments}}
    </div>
</div>
